<?xml version="1.0" encoding="utf-8"?>
<!--
  Prism - Windows MSI package (WiX v6+).

  Build with installer/windows/build-msi.ps1, which supplies the preprocessor
  variables this file needs:
    -d PrismVersion=<numeric version, e.g. 0.9.1>
    -d PrismExe=<absolute path to the built prism.exe>
    -d IconFile=<absolute path to internal/platform/logo_icon.ico>
    -d Scope=perUser|perMachine

  Scope:
    * perUser (default) installs to %LOCALAPPDATA%\Programs\Prism, records its
      install state under HKCU, and never prompts for elevation. The in-app
      updater hands a new MSI to msiexec without an elevation prompt.
    * perMachine installs to %ProgramFiles%\Prism and records state under HKLM,
      so every upgrade needs an elevated msiexec. The updater in
      internal/desktop/update_windows.go does not elevate yet - see the
      "Windows MSI" section of AGENTS.md before shipping a per-machine package.

  Deliberately NOT authored here:

    * Unconditional uninstall-time cleanup of HKCU\...\Run\Prism, the "start
      with Windows" value the app owns (internal/platform/autostart_windows.go).
      A RemoveRegistryValue row fires on *every* removal of the product,
      including the one a major upgrade performs, so it would silently turn
      auto-start off on each update. The AutoStartValue component below adopts
      the value only when the search finds one already there: MSI then owns the
      row, so an uninstall removes it, while a fresh install never switches
      auto-start on behind the user's back. A value the user turns on *after*
      installing is still not MSI's to remove, and stays behind.

    * A desktop shortcut. With no installer UI it cannot be an option, and a
      tray app does not need one.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <?define ProductName="Prism" ?>
  <?define MarkerKey="Software\Prism" ?>

  <?if $(var.Scope) = "perMachine" ?>
  <?define MarkerRoot="HKLM" ?>
  <?else ?>
  <?define MarkerRoot="HKCU" ?>
  <?endif ?>

  <Package Name="$(var.ProductName)"
           Manufacturer="Prism"
           Version="$(var.PrismVersion)"
           UpgradeCode="{10F8B1C4-F448-419B-A5AE-48B2B17B6B0D}"
           Scope="$(var.Scope)"
           Language="1033">

    <!-- afterInstallInitialize removes the previous version before laying down
         the new files, which gives upgrades and fresh installs one code path
         and sidesteps the file-versioning rules of minor upgrades. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Prism is already installed. Uninstall it first if you need to downgrade." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Install context. Scope="perUser" marks the package UAC compliant
         (limited privileges) and that flag is the whole mechanism: Windows
         Installer performs a per-user install in the user's own hive without
         elevation. Authoring ALLUSERS=2 + MSIINSTALLPERUSER=1 on top of it - the
         documented "dual purpose" pair - does nothing here, because the
         installer *deletes* ALLUSERS and reports "MSIINSTALLPERUSER property is
         not valid for UAC compliant package. Ignoring". Verified against a real
         install; Assert-MsiScope now checks the flag instead of those rows.

         Nor is the registration location a sign of elevation: a per-user
         package registers under HKLM\...\Installer\UserData\<SID>\Products
         with its ARP entry in HKLM\...\Uninstall even when nothing elevated,
         which is what a silent non-elevated install, upgrade and uninstall of
         this shape of package were measured doing. The in-app updater therefore
         needs no elevation (see update_windows.go). The only ALLUSERS value to
         avoid here is 1, which forces a per-machine install. -->

    <!-- Non-empty when the user already has auto-start on, which is what
         conditions the AutoStartValue component: an existing entry is adopted
         (repointed at the installed exe) rather than duplicated or ignored.
         Like a Feature, a search property must be inside Package - in a
         Fragment WiX v6 drops it without a word. -->
    <Property Id="PRISM_AUTOSTART_PATH">
      <RegistrySearch Id="PrismAutoStartSearch"
                      Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="Prism"
                      Type="raw" />
    </Property>

    <!-- The Feature has to live inside Package, not in a Fragment of its own.
         WiX v6 silently discards a Feature that sits outside the Package, and
         with it every component the Feature references: the build succeeds,
         reports no warning, and produces an ~28 KB MSI with no File rows, no
         Component table and no payload. Verified by comparing a Fragment
         Feature (empty package) against this one (full payload). Keep the
         directories and components below in Fragments, where they do work. -->
    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

    <!-- Start the app once the install finishes, the way a downloaded
         installer is expected to behave, and again after an in-place upgrade:
         util:CloseApplication has just terminated the running copy, so without
         WIX_UPGRADE_DETECTED a manual upgrade would leave the user with a
         closed tray. ExeCommand is empty but still
         required: WiX demands one of the type attributes for the action
         (WIX0044) and ties Return="asyncNoWait" to ExeCommand (WIX0038), so
         removing it breaks the build. Execute="immediate" is what keeps this
         legal after InstallFinalize - a deferred action cannot be sequenced
         there - and starts the tray as the installing user, not elevated. -->
    <CustomAction Id="LaunchPrism"
                  FileRef="PrismExe"
                  ExeCommand=""
                  Execute="immediate"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchPrism" After="InstallFinalize"
              Condition="NOT Installed OR WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <!-- Prism runs as two processes with the same image name: the tray parent
         and its `prism.exe` child started with the serve flag. TerminateProcess
         kills both, which is what lets an upgrade replace the file while the
         app is running. RebootPrompt has to be "no" whenever
         TerminateProcess is set. Like the CustomAction above, this belongs
         inside Package - in a Fragment WiX v6 drops it without a word. -->
    <util:CloseApplication Id="CloseRunningPrism"
                           Target="prism.exe"
                           TerminateProcess="1"
                           PromptToContinue="no"
                           RebootPrompt="no" />
  </Package>

  <Fragment>
    <Icon Id="PrismIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="PrismIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/KavinMK05/Prism" />
    <Property Id="ARPHELPLINK" Value="https://github.com/KavinMK05/Prism#readme" />
  </Fragment>

  <Fragment>
    <?if $(var.Scope) = "perMachine" ?>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
    </StandardDirectory>
    <?else ?>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>
    <?endif ?>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramsFolder" Name="$(var.ProductName)" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="{D11BC0CB-B619-4957-A62B-F0BCF3027186}">
        <File Id="PrismExe" Source="$(var.PrismExe)" KeyPath="yes" />
      </Component>

      <!-- Install state the app reads to tell an MSI-managed copy from a
           portable one (see internal/platform/install_windows.go). The value
           names are a public contract: changing them breaks install-type
           detection in already-shipped binaries. -->
      <Component Id="InstallState" Guid="{9DC04FE3-10B2-49BB-8275-C7C60748DC87}">
        <RegistryValue Root="$(var.MarkerRoot)"
                       Key="$(var.MarkerKey)"
                       Name="InstallType"
                       Type="string"
                       Value="msi"
                       KeyPath="yes" />
        <RegistryValue Root="$(var.MarkerRoot)"
                       Key="$(var.MarkerKey)"
                       Name="InstallDir"
                       Type="string"
                       Value="[INSTALLFOLDER]" />
        <RegistryValue Root="$(var.MarkerRoot)"
                       Key="$(var.MarkerKey)"
                       Name="InstalledVersion"
                       Type="string"
                       Value="[ProductVersion]" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>

      <!-- Adopt a pre-existing auto-start entry. The app writes the path of
           whatever binary the user toggled it from
           (internal/platform/autostart_windows.go), so the value goes stale as
           soon as that build is replaced: a dev checkout, a portable copy or an
           earlier install path keeps winning at sign-in while the installed
           copy never starts, and two instances then fight over the
           single-instance lock. Conditioned on the search above, so a fresh
           install leaves auto-start off and MSI owns the row for an uninstall.
           platform.SyncAutoStartPath covers the same case for the portable
           channel. -->
      <Component Id="AutoStartValue" Guid="{B9502339-B730-4E28-993D-54B17C545ABA}"
                 Condition="PRISM_AUTOSTART_PATH">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="Prism"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]prism.exe&quot;"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ShortcutComponents" Directory="AppProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="{32149E8C-D3C4-406A-BF37-7C03C5486153}">
        <Shortcut Id="PrismStartMenuShortcut"
                  Name="$(var.ProductName)"
                  Description="Prism - LLM API proxy"
                  Target="[INSTALLFOLDER]prism.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="PrismIcon" />
        <RemoveFolder Id="RemoveAppProgramsFolder" On="uninstall" />
        <RegistryValue Root="$(var.MarkerRoot)"
                       Key="$(var.MarkerKey)"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

</Wix>
